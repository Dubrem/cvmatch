# Google Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Base de datos Postgres (Render la inyecta automáticamente en producción)
DATABASE_URL=

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Cadena secreta para firmar las sesiones de /cuenta (usa una larga y aleatoria)
SESSION_SECRET=

# Gmail para enviar el correo de confirmacion cuando se aprueba un pago
# GMAIL_USER: la cuenta de Gmail (ej. primermatchcv@gmail.com)
# GMAIL_APP_PASSWORD: "contraseña de aplicación" generada en myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
